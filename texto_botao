import { useState } from 'react';
import { View, Text, TextInput, Pressable, StyleSheet } from 'react-native';

export default function App() {
  const [texto, setTexto] = useState('');   // o que está sendo digitado
  const [tarefa, setTarefa] = useState(''); // a última tarefa adicionada

  function adicionarTarefa() {
    setTarefa(texto); // guarda o que foi digitado
    setTexto('');     // limpa o campo
  }

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Minhas Tarefas</Text>
      <Text style={styles.subtitulo}>Organize o seu dia</Text>

      <View style={styles.linhaEntrada}>
        <TextInput
          style={styles.campo}
          placeholder="Nova tarefa"
          value={texto}
          onChangeText={setTexto}
        />
        <Pressable style={styles.botao} onPress={adicionarTarefa}>
          <Text style={styles.textoBotao}>Adicionar</Text>
        </Pressable>
      </View>

      <Text style={styles.resultado}>Última tarefa: {tarefa}</Text>
    </View>
  );
}

