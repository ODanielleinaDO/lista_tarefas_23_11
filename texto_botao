    color: '#212121',
  },
  subtitulo: {
    fontSize: 16,
    color: '#616161',
    marginBottom: 20,
  },
  linhaEntrada: {
    flexDirection: 'row', // lado a lado
    marginBottom: 20,
  },
  campo: {
    flex: 1, // ocupa todo o espaço que sobrar
    minWidth: 0, // deixa o campo encolher para o botão caber na tela
    backgroundColor: '#FFFFFF',
    borderWidth: 1,
    borderColor: '#BDBDBD',
    borderRadius: 8,
    paddingHorizontal: 12,
    fontSize: 16,
  },
  botao: {
    backgroundColor: '#1565C0',
    borderRadius: 8,
    paddingHorizontal: 16,
    justifyContent: 'center',
    marginLeft: 8,
  },
  textoBotao: {
    color: '#FFFFFF',
    fontSize: 16,
    fontWeight: 'bold',
  },
  resultado: {
    fontSize: 16,
    color: '#212121',
  },
});
